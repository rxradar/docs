          "href": "https://rxradar.xyz/api#playground",
          "icon": "play"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/rxradar",
          "icon": "github"
        },
        {
          "anchor": "Changelog",
          "href": "https://rxradar.xyz/changelog",
          "icon": "list"
        }
      ]
    }
