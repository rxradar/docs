              "quickstart"
            ]
          },
          {
            "group": "Use Cases",
            "pages": [
              "use-cases/price-benchmark",
              "use-cases/promotion-tracking",
              "use-cases/stock-monitoring",
              "use-cases/digital-shelf",
              "use-cases/distribution-monitoring",
              "use-cases/reputation-monitoring"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              "api-reference/introduction",
              {
