                  "api-reference/networks/stores"
                ]
              },
              {
                "group": "Stores",
                "pages": [
                  "api-reference/stores/list",
                  "api-reference/stores/get"
                ]
              },
              {
                "group": "Products",
                "pages": [
                  "api-reference/products/list",
                  "api-reference/products/by-gtin",
                  "api-reference/products/get",
                  "api-reference/products/reviews",
                  "api-reference/products/variants",
